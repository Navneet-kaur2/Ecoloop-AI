# Copy this file to .env and fill in your real Groq API key.
# Get a key from https://console.groq.com/keys (it starts with "gsk_").
GROQ_API_KEY=gsk_your_key_here

# Groq vision model for the waste scanner. Run `python list_models.py` to see
# which model ids are available on your account, then set this to a
# vision-capable model from that list.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
